{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://fitstart-wrun.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://fitstart-wrun.onrender.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
